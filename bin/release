#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: bin/release [description]
# Releases v<gemspec version>; the description is asked for if not given.
# RubyGems uses the credentials from `gem signin` and asks for a one-time password. The gem.coop API key is
# asked for, not read from the environment, and is only given to the gem.coop push.

require "bundler/gem_helper"
require "io/console"
require "net/http"

def ask(question)
  print "#{question}: "
  answer = $stdin.gets.to_s.strip
  answer unless answer.empty?
end

# Not echoed, for API keys
def ask_secret(question)
  print "#{question}: "
  answer = $stdin.noecho(&:gets).to_s.strip
  puts
  answer unless answer.empty?
end

# env is set for this one command only; a nil value removes the variable from it. shown is what gets printed.
def run(*cmd, env: {}, shown: cmd)
  puts "$ #{shown.join(" ")}"
  system(env, *cmd) || abort("Failed: #{shown.join(" ")}")
end

# Compact index lists every published version of the gem as the first word of each line.
def published?(host, name, version)
  response = Net::HTTP.get_response(URI("#{host}/info/#{name}"))
  case response
  when Net::HTTPSuccess then response.body.each_line.any? { |line| line.split(" ", 2).first == version }
  when Net::HTTPNotFound then false
  else abort "Could not check #{host} for #{name} #{version}: #{response.code}"
  end
end

# Checked before switching branches, so a dirty tree is never carried over to main.
abort "Working tree is not clean" unless `git status --porcelain`.empty?

run("git", "checkout", "main")
run("git", "pull", "--ff-only", "origin", "main")
abort "main does not match origin/main" unless `git rev-parse main`.strip == `git rev-parse origin/main`.strip

# Loaded after checking out main, so the gemspec is main's.
helper = Bundler::GemHelper.new(File.expand_path("..", __dir__))
name = helper.gemspec.name
version = helper.gemspec.version.to_s
tag = "v#{version}"
coop = "https://gem.coop/@joe-sharp"

description = ARGV.first || ask("Release description") or abort "A description is required"

tag_exists = system("git", "rev-parse", "-q", "--verify", "refs/tags/#{tag}", out: File::NULL)
tag_commit = `git rev-parse "#{tag}^{commit}"`.strip if tag_exists
abort "#{tag} already exists but does not point at HEAD" if tag_exists && tag_commit != `git rev-parse HEAD`.strip

rubygems_published = published?(Gem.host, name, version)
coop_published = published?(coop, name, version)

puts "\nTag #{tag}: #{description}"
exit unless ask("Tag, push, build and publish? (y/N)").to_s.downcase.start_with?("y")

# Only asked for when gem.coop still needs the gem, and kept in memory for that one push
coop_key = ask_secret("gem.coop API key") unless coop_published
abort "A gem.coop API key is required" if !coop_published && coop_key.nil?

# Built first, so a build failure stops the release before anything is tagged or published
puts "$ gem build #{File.basename(helper.spec_path)}"
gem_file = helper.build_gem

if tag_exists
  puts "#{tag} already exists at HEAD; not creating it again"
else
  run "git", "tag", "-a", tag, "-m", description
end

if rubygems_published
  puts "#{name} #{version} is already on #{Gem.host}; skipping"
else
  otp = ask("RubyGems one-time password") or abort "A RubyGems one-time password is required"
  # GEM_HOST_API_KEY takes priority over stored credentials, so it is removed for this push
  run("gem", "push", "--otp", otp, gem_file, env: { "GEM_HOST_API_KEY" => nil }, shown: ["gem", "push", gem_file])
end

if coop_published
  puts "#{name} #{version} is already on #{coop}; skipping"
else
  run("gem", "push", "--host", coop, gem_file, env: { "GEM_HOST_API_KEY" => coop_key })
end

# Last, so the tag only goes public once the gem is out.
# Pushing a tag the remote already has at the same commit is a no-op.
run "git", "push", "origin", tag
