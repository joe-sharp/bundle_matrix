# frozen_string_literal: true

# Appraisal2 rebuilds generated gemfiles from the parsed DSL, which drops
# comments, so keep the magic comment in the generated heading.
customize_gemfiles do
  {
    heading: "frozen_string_literal: true\n\nThis file was generated by Appraisal2"
  }
end

plugin "appraisal2-rubocop", require: "appraisal2/rubocop"

# Appraisal2 copies the root Gemfile's rubygems.org source into every appraisal.
# The gem-coop appraisal sets its own global source, so drop the copied line
# to keep a single global source and avoid Bundler's warning.
#
# rubocop:disable-next Style/RedundantConstantBase
::Appraisal.transform_gemfile do |content, context|
  next unless context.appraisal.name == "gem-coop"

  content.sub(%r{^source ["']https://rubygems\.org/?["']\n}, "")
end

# Gems the Gemfile needs for development, not for running the specs against a Bundler version
DEV_GEMS = %w[
  appraisal2
  appraisal2-rubocop
  guard
  guard-rspec
  guard-rubocop
  guard-shell
  guard-status
  irb
  ostruct
  rbs
  rubocop
  simplecov
  steep
].freeze

JOE_GEMS = %w[
  boondoc
  guard-boondoc
  sharp_style_rubocop
].freeze

# rubocop:disable-next Style/MethodCallWithArgsParentheses
def bundler_appraisal(version)
  appraise "bundler-#{version}" do
    (DEV_GEMS + JOE_GEMS).each { |name| remove_gem name }

    gem "bundler", version
  end
end

bundler_appraisal "2.6.9"
bundler_appraisal "2.7.2"
bundler_appraisal "4.0.24"
bundler_appraisal "4.1.0.beta3"

appraise "gem-coop" do
  source "https://gem.coop/"

  (DEV_GEMS + JOE_GEMS).each { |name| remove_gem name }

  source "https://gem.coop/@joe-sharp" do
    JOE_GEMS.each { |name| gem name }
  end
end
